# HealthIT local settings
HEALTHIT_LOG_LEVEL=INFO
HEALTHIT_STALE_AFTER_SECONDS=60
HEALTHIT_DB_PATH=data/healthit.db

# Optional: use this when another machine needs a stable callback URL.
# HEALTHIT_PUBLIC_URL=http://YOUR-DASHBOARD-IP:8000

# Optional: protect telemetry posts with a shared token.
# HEALTHIT_TELEMETRY_TOKEN=change-me

# Optional: only enable this on trusted local networks.
# HEALTHIT_ENABLE_SSH=false
# HEALTHIT_SSH_USER=pi
# HEALTHIT_SSH_TIMEOUT_SECONDS=12
# HEALTHIT_TERMINAL_TIMEOUT_SECONDS=30
